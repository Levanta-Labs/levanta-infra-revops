{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/aircall-touchpoint-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/instantly-touchpoint-sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/heyreach-touchpoint-sync",
      "schedule": "*/5 * * * *"
    }
  ]
}
